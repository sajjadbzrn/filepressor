{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FilePressor",
  "version": "0.2.0",
  "identifier": "com.sajjadbzrn.filepressor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FilePressor",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "backgroundColor": "#FAF9FB"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://ghcr-mirror.liara.ir/sajjadbzrn/filepressor/releases/latest/download/latest.json",
        "https://github.com/sajjadbzrn/filepressor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1MkZCMEZFQTU5QjBGNTQKUldSVUQ1dWwvckF2aGQ3NlorZno5YllSU1VrZFlqRXVsaVRXMFdpYTZrWHIrNlBQZHJxc3F2Z0cK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
